{
  "name": "Hotel Revenue - Harbour",
  "dataColors": [
    "#1F4E79",
    "#C9A227",
    "#2A9D8F",
    "#E07A5F",
    "#6B7A8F",
    "#8E7DBE",
    "#264653",
    "#F2B880"
  ],
  "foreground": "#1B2A41",
  "foregroundNeutralSecondary": "#5B6B80",
  "foregroundNeutralTertiary": "#94A3B8",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F6F9",
  "backgroundNeutral": "#E3E7ED",
  "tableAccent": "#1F4E79",
  "good": "#2A9D8F",
  "neutral": "#C9A227",
  "bad": "#E07A5F",
  "maximum": "#1F4E79",
  "center": "#C9D6E3",
  "minimum": "#F4F6F9",
  "hyperlink": "#1F4E79",
  "visitedHyperlink": "#264653",
  "textClasses": {
    "callout": { "fontSize": 30, "fontFace": "Segoe UI Semibold", "color": "#1B2A41" },
    "title": { "fontSize": 13, "fontFace": "Segoe UI Semibold", "color": "#1B2A41" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1B2A41" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#5B6B80" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E3E7ED" } }, "radius": 10 }],
        "dropShadow": [{ "show": true, "color": { "solid": { "color": "#1B2A41" } }, "transparency": 90, "position": "Outer", "preset": "Custom", "shadowDistance": 2, "shadowBlur": 8, "shadowSpread": 0, "angle": 90 }],
        "padding": [{ "top": 12, "bottom": 12, "left": 16, "right": 16 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1B2A41" } }, "fontSize": 13, "fontFamily": "Segoe UI Semibold", "alignment": "left" }],
        "visualHeader": [{ "background": { "solid": { "color": "#FFFFFF" } }, "border": { "solid": { "color": "#FFFFFF" } }, "foreground": { "solid": { "color": "#5B6B80" } } }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#5B6B80" } }, "fontSize": 10, "showAxisTitle": false, "titleColor": { "solid": { "color": "#5B6B80" } } }],
        "valueAxis": [{ "labelColor": { "solid": { "color": "#5B6B80" } }, "fontSize": 10, "showAxisTitle": false, "gridlineShow": true, "gridlineColor": { "solid": { "color": "#EEF1F5" } }, "gridlineStyle": "dotted", "titleColor": { "solid": { "color": "#5B6B80" } } }],
        "legend": [{ "show": true, "position": "Top", "labelColor": { "solid": { "color": "#5B6B80" } }, "fontSize": 10 }],
        "labels": [{ "color": { "solid": { "color": "#1B2A41" } }, "fontSize": 10 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6F9" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#E9EDF2" } }, "transparency": 0 }]
      }
    },
    "cardVisual": {
      "*": {
        "value": [{ "fontSize": 30, "fontFamily": "Segoe UI Semibold", "fontColor": { "solid": { "color": "#1F4E79" } } }],
        "label": [{ "show": true, "fontSize": 11, "fontColor": { "solid": { "color": "#5B6B80" } } }],
        "accentBar": [{ "$id": "default", "show": true, "color": { "solid": { "color": "#C9A227" } }, "position": "Left", "width": 4 }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 3, "showMarker": true, "markerSize": 5 }],
        "labels": [{ "show": false }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [{ "show": true, "labelDisplayUnits": 0 }],
        "valueAxis": [{ "show": false }]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "labels": [{ "show": false }],
        "legend": [{ "show": true, "position": "TopRight" }]
      }
    },
    "donutChart": {
      "*": {
        "labels": [{ "show": true, "labelStyle": "Category, percent of total" }],
        "slices": [{ "innerRadiusRatio": 65 }],
        "legend": [{ "show": false }]
      }
    },
    "advancedSlicerVisual": {
      "*": {
        "accentBar": [{ "$id": "default", "show": true, "color": { "solid": { "color": "#C9A227" } } }],
        "fillCustom": [{ "$id": "selection:selected", "fillColor": { "solid": { "color": "#1F4E79" } }, "transparency": 0 }]
      }
    }
  }
}
